# Base URL of the p2p-carsharing-api backend, including its /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Set to "true" to skip auth locally without a real token.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Stripe publishable key (safe to expose — pairs with the backend's secret
# key). Get it from the Stripe Dashboard, Developers -> API keys, same
# account/mode as the backend's STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
